<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OficinaMecanica.Application\OficinaMecanica.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- Optei por fixar a versao corrigida: o MailKit traz o Pkcs 8.0.1 (CVE-2026-84008, negacao de servico) como dependencia transitiva e o scan da imagem no CI reprova HIGH com correcao publicada. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <!-- Optei por fixar a 8.5.12: a linha 9.x do MassTransit exige licenca comercial (ADR 0004). -->
    <PackageReference Include="MassTransit" Version="8.5.12" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.5.12" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
    <!-- O JwtBearer 8.0.0 arrasta o IdentityModel 7.0.3, cujo JsonWebTokens e System.IdentityModel.Tokens.Jwt tem
         vulnerabilidade (GHSA-59j7-ghrg-fj52). Optei por fixar a versao corrigida da mesma linha 7.x. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="7.7.1" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="7.7.1" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="7.7.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.7.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.22">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OficinaMecanica.Infrastructure.Tests" />
  </ItemGroup>

</Project>
