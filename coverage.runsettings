<?xml version="1.0" encoding="utf-8"?>
<!-- Cobertura de linhas do servico inteiro (formato OpenCover, que o ReportGenerator e o SonarCloud leem).
     Entram so os assemblies do servico; os projetos de teste e o Tests.Common ficam de fora. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <Include>[OficinaMecanica.Domain]*,[OficinaMecanica.Application]*,[OficinaMecanica.Infrastructure]*,[OficinaMecanica.API]*,[OficinaMecanica.Contracts]*</Include>
          <!-- CompilerGeneratedAttribute NAO esta na lista de proposito: ele tiraria da medida iteradores, lambdas e maquinas de
               estado async, que sao codigo escrito por nos, e inflaria o numero. -->
          <!-- ExcludeFromCodeCoverageAttribute e honrado: o codigo marcado some, em silencio, de TODAS as medicoes (bruta e com
               exclusoes) e do gate. Usar so com justificativa em ADR; o scripts/cobertura.sh lista as ocorrencias no relatorio. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SingleHit>false</SingleHit>
          <SkipAutoProps>false</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
