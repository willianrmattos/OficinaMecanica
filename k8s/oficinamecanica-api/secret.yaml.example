# kubectl apply -f k8s/oficinamecanica-api/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: oficinamecanica-secrets
type: Opaque
stringData:
  sql-connection-string: "Server=tcp:<server>.database.windows.net,1433;Database=OficinaMecanicaDb;User Id=adminfiap;Password=<senha>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  jwt-secret-key: "<chave-jwt>"
  admin-senha: "<senha-admin>"
