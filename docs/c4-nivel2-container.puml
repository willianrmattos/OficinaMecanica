@startuml c4-nivel2-container
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title OficinaMecanica - Nivel 2: Container

Person(admin, "Administrador", "Usuario autenticado com JWT")
Person_Ext(cliente, "Cliente Final", "Acesso anonimo a endpoints publicos")
System_Ext(smtp, "Servidor SMTP", "Mailpit (dev) - notificacoes de status por e-mail")

Container(apim, "Azure API Management", "Consumption tier", "Gateway na frente de todos os backends. Modelo wildcard/passthrough por API - path /oficinaserver pra API (via ingress-nginx), /grafana pro Grafana (via ingress-nginx), /segurancaserver pro Seguranca (Azure Function, backend publico direto). Sem exigir subscription key (cada backend ja tem seu proprio controle de acesso).")

System_Boundary(oficina, "OficinaMecanica (AKS)") {
    Container(api, "OficinaMecanica API", ".NET 8 / ASP.NET Core 8", "REST API com Clean Architecture, DDD e CQRS via MediatR. So VALIDA tokens JWT (RS256/JWKS, emitidos pelo OficinaMecanica.Seguranca) - nao emite mais nenhum. Valida entradas com FluentValidation. Emite metricas (prometheus-net), logs (Serilog) e traces (OpenTelemetry). Escalada de 2 a 5 replicas via HPA.")
    ContainerDb(db, "OficinaMecanicaDb", "Azure SQL Database", "Persiste clientes, veiculos, servicos, pecas, ordens de servico e historico de status. Concorrencia otimista com ConcurrencyToken. Tier serverless sempre-gratis.")

    Container(prometheus, "Prometheus", "kube-prometheus-stack", "Coleta e armazena metricas via scrape periodico do endpoint /metrics.")
    Container(grafana, "Grafana", "kube-prometheus-stack", "Dashboards e consulta unificada de metricas, logs e traces.")
    Container(loki, "Loki", "Modo Monolithic", "Armazena e indexa os logs agregados dos pods.")
    Container(alloy, "Grafana Alloy", "DaemonSet", "Le o log de cada container do node e envia pro Loki.")
    Container(jaeger, "Jaeger", "All-in-one", "Recebe e armazena os traces distribuidos exportados pela API via OTLP.")
}

System_Boundary(seguranca_sys, "OficinaMecanica.Seguranca (repositorio separado)") {
    Container(seguranca, "OficinaMecanica.Seguranca", ".NET 8 / Azure Functions (isolated worker)", "Emite tokens JWT (RS256) e expoe a chave publica via JWKS (/.well-known/jwks.json), pra qualquer API do ecossistema validar sem segredo compartilhado. Tier Consumption. Sem AKS - endpoint HTTPS publico proprio.")
    ContainerDb(segurancaDb, "SegurancaDb", "Azure SQL Database", "Persiste usuarios (senha com hash BCrypt). Banco separado, mesmo servidor logico do OficinaMecanicaDb.")
}

Rel(admin, apim, "Autentica (login)", "HTTPS / REST")
Rel(admin, apim, "Chama endpoints administrativos", "HTTPS / REST / JWT Bearer")
Rel(admin, apim, "Visualiza dashboards, logs e traces", "HTTPS")
Rel(cliente, apim, "Consulta OS e aprova ou recusa orcamento", "HTTPS / REST (anonimo)")
Rel(apim, api, "Roteia /oficinaserver via ingress-nginx (backend publico, wildcard passthrough)", "HTTP")
Rel(apim, grafana, "Roteia /grafana via ingress-nginx (backend publico, wildcard passthrough)", "HTTP")
Rel(apim, seguranca, "Roteia /segurancaserver (backend publico direto, sem AKS/ingress-nginx no meio)", "HTTPS")
Rel(api, db, "Le e escreve via EF Core", "TCP 1433 / TDS")
Rel(seguranca, segurancaDb, "Le e escreve via EF Core", "TCP 1433 / TDS")
Rel(api, smtp, "Envia notificacao a cada mudanca de status", "SMTP (MailKit)")
Rel(smtp, cliente, "Entrega notificacao", "E-mail")

Rel(prometheus, api, "Coleta metricas via scrape", "HTTP /metrics")
Rel(alloy, api, "Le os logs do container", "arquivo de log do node")
Rel(alloy, loki, "Envia logs coletados", "HTTP")
Rel(api, jaeger, "Exporta spans de tracing", "OTLP / gRPC")
Rel(grafana, prometheus, "Consulta metricas", "PromQL")
Rel(grafana, loki, "Consulta logs", "LogQL")
Rel(grafana, jaeger, "Consulta traces", "HTTP")

@enduml
