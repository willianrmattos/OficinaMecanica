@startuml c4-nivel3-componente
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title OficinaMecanica API - Nivel 3: Componente

Person(admin, "Administrador", "Usuario autenticado")
Person_Ext(cliente, "Cliente Final", "Acesso anonimo")
ContainerDb_Ext(db, "OficinaMecanicaDb", "Azure SQL Database")
System_Ext(smtp, "Servidor SMTP", "Mailpit (dev)")

Container_Boundary(api, "OficinaMecanica API (.NET 8)") {

    Component(middleware, "ExceptionHandlingMiddleware", "ASP.NET Core Middleware", "Captura DomainException (409), ValidationException (400) e excecoes genericas (500). Retorna ProblemDetails sem expor stack trace.")

    Component(controllers, "Controllers REST", "ASP.NET Core [ApiController]", "ClientesController, VeiculosController, ServicosController, PecasController, OrdensDeServicoController. Sem AuthController/TokenService - login e emissao de token viraram responsabilidade exclusiva do OficinaMecanica.Seguranca (repositorio separado); esta API so valida o JWT (RS256/JWKS) via middleware de autenticacao padrao do ASP.NET Core.")

    Component(pipeline, "ValidationBehavior", "MediatR IPipelineBehavior", "Intercepta todo Command e Query. Executa FluentValidation e lanca ValidationException se invalido.")

    Component(cmdHandlers, "Command Handlers", "MediatR IRequestHandler (escrita)", "CriarCliente, AtualizarCliente, RemoverCliente, CriarVeiculo, AtualizarVeiculo, RemoverVeiculo, CriarServico, AtualizarServico, DesativarServico, CriarPeca, AtualizarPeca, DesativarPeca, AdicionarEstoquePeca, CriarOrdemDeServico, AtualizarStatusOrdem, AprovarOrcamento, RecusarOrcamento.")

    Component(qryHandlers, "Query Handlers", "MediatR IRequestHandler (leitura)", "ObterCliente, ListarClientes, ObterClientePorDocumento, ObterVeiculo, ListarVeiculos, ObterServico, ListarServicos, ObterPeca, ListarPecas, ObterOrdemDeServico, ListarOrdensDeServico (exclui Finalizada/Entregue por padrao, ordena por prioridade de status), ObterTempoMedioServicos.")

    Component(aggregates, "Agregados (DDD)", "Domain Entities / AggregateRoot", "Cliente, Veiculo, OrdemDeServico, Servico, Peca. Encapsulam invariantes e regras de negocio. Fluxo de status da OS controlado pelo dominio (Recebida ate Entregue, com o desvio AguardandoAprovacao -> OrcamentoRecusado). Baixa automatica de estoque ao aprovar orcamento (nao ocorre ao recusar).")

    Component(valueObjects, "Value Objects", "Domain ValueObject", "Documento: valida CPF e CNPJ com algoritmo de digitos verificadores. Placa: valida formato antigo (ABC1234) e Mercosul (ABC1D23).")

    Component(domainEvents, "Domain Events", "MediatR INotification", "OrdemDeServicoCriadaEvent, StatusOrdemAlteradoEvent, OrcamentoGeradoEvent, OrcamentoAprovadoEvent, OrcamentoRecusadoEvent. Publicados pelo AppDbContext via IMediator apos SaveChangesAsync.")

    Component(eventHandlers, "Event Handlers", "MediatR INotificationHandler", "StatusOrdemAlteradoEventHandler: consome StatusOrdemAlteradoEvent (qualquer transicao de status) e envia notificacao por e-mail ao cliente via IEmailService. MetricasNegocioEventHandlers: consome OrdemDeServicoCriadaEvent e OrcamentoRecusadoEvent, so incrementa contadores de observabilidade. OrcamentoGeradoEvent e OrcamentoAprovadoEvent ainda nao tem consumidor.")

    Component(emailSvc, "IEmailService / SmtpEmailService", "Application.Interfaces / Infrastructure.Services (MailKit)", "Envia e-mail via SMTP direto (sem provedor externo). Resiliente: falha de conexao/envio so loga Warning, nunca lanca excecao.")

    Component(repos, "Repositories", "EF Core / IRepository", "ClienteRepository, VeiculoRepository, ServicoRepository, PecaRepository, OrdemDeServicoRepository. Implementam interfaces definidas no dominio.")

    Component(dbctx, "AppDbContext / IUnitOfWork", "Entity Framework Core 8", "Configuracoes Fluent API com ConcurrencyToken. Gerencia transacoes ACID. Publica Domain Events via IMediator apos SaveChangesAsync.")

    Component(metricas, "MetricasNegocio", "System.Diagnostics.Metrics (Meter)", "Contadores (OrdensCriadas, OrcamentosRecusados, EmailsFalha) e histograma (TempoExecucaoHoras, com dimensao 'status'). MetricasDeNegocioBackgroundService recalcula o tempo medio por status a cada 5 minutos, via IOrdemDeServicoRepository. Exportado via OpenTelemetry (OTLP) pro OpenTelemetry Collector.")
}

Rel_D(admin, middleware, "Requisicoes autenticadas (JWT Bearer)", "HTTPS")
Rel_D(cliente, middleware, "Consulta OS e aprova ou recusa orcamento", "HTTPS")
Rel_D(middleware, controllers, "Repassa apos tratamento de erros")
Rel_D(controllers, pipeline, "Despacha Command ou Query", "IMediator.Send")
Rel_D(pipeline, cmdHandlers, "Encaminha apos validacao")
Rel_D(pipeline, qryHandlers, "Encaminha apos validacao")
Rel_R(cmdHandlers, aggregates, "Cria e manipula agregados")
Rel(aggregates, valueObjects, "Usa para validacao")
Rel(aggregates, domainEvents, "Registra eventos")
Rel_D(cmdHandlers, repos, "Persiste via interfaces do dominio")
Rel_D(qryHandlers, repos, "Consulta via interfaces do dominio")
Rel_D(repos, dbctx, "Usa transacao compartilhada")
Rel(dbctx, domainEvents, "Publica pos-SaveChanges", "IMediator.Publish")
Rel_D(dbctx, db, "Le e escreve via EF Core", "SQL / TDS 1433")
Rel_D(domainEvents, eventHandlers, "Despacha os eventos consumidos", "IMediator.Publish")
Rel(eventHandlers, emailSvc, "Envia notificacao", "IEmailService")
Rel_R(emailSvc, smtp, "Conecta e envia", "SMTP")
Rel(eventHandlers, metricas, "Incrementa contadores")
Rel(repos, metricas, "Alimenta o calculo do tempo medio", "ObterTempoMedioPorStatusAsync")

@enduml
