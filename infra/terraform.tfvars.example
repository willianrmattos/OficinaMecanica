location              = "northcentralus"
resource_group_name   = "rgfiap"
storage_account_name  = "stfiap"
registry_name         = "acrfiap"
aks_cluster_name      = "aksfiap"
key_vault_name        = "kvfiap"
sql_location          = "canadacentral"
sql_server_name       = "svsfiap"
sql_database_name     = "OficinaMecanicaDb"
sql_administrator_login = "adminfiap"
github_repo           = "willianrmattos/OficinaMecanica"

# aks_authorized_ip_ranges    = ["203.0.113.5/32"] # opcional: restringe o acesso ao API server publico a este IP/32
# sql_client_ip_address       = "203.0.113.5"      # opcional: libera acesso direto ao banco a partir deste IP
# key_vault_client_ip_address = "203.0.113.5"      # opcional: libera acesso direto ao Key Vault a partir deste IP

# sql_administrator_login_password. Utilizar uma variavel de ambiente:
# $env:TF_VAR_sql_administrator_login_password = "<senha-forte>"
